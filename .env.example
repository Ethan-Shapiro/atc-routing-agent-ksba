# === OpenSky Network (OAuth2 client_credentials — register at opensky-network.org) ===
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
# Daily request-credit budget for your account tier (anonymous=400, registered=4000, active feeder=8000).
# The poller tracks usage against this and skips polls rather than risk a 429 / tier violation.
OPENSKY_DAILY_CREDIT_BUDGET=4000

# === Hugging Face (Phase 4 — fine-tuning, not used yet) ===
HUGGINGFACE_TOKEN=

# === Anthropic (Phase 3 — Clearance/Ground/Tower/Approach reasoning nodes) ===
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5

# === PostGIS (domain telemetry database) ===
POSTGIS_DB=atc_geo
POSTGIS_USER=atc_admin
POSTGIS_PASSWORD=
POSTGIS_HOST=postgis
POSTGIS_PORT=5432

# === Airflow metadata database (separate physical Postgres, not PostGIS) ===
AIRFLOW_DB=airflow_meta
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=
AIRFLOW__CORE__FERNET_KEY=
AIRFLOW__API_AUTH__JWT_SECRET=
_AIRFLOW_WWW_USER_USERNAME=admin
_AIRFLOW_WWW_USER_PASSWORD=

# === Domain constants (Santa Barbara Municipal — KSBA) ===
AIRPORT_LAT=34.4262
AIRPORT_LON=-119.8415
# KSBA is a much lower-traffic field than LAX — 25mi comfortably covers approach/departure
# corridors without wasting OpenSky credit budget polling empty sky.
COVERAGE_RADIUS_MILES=25
# Deliberately not 10 — see README/plan notes on OpenSky credit budget math.
POLL_INTERVAL_SECONDS=12
