# Secrets
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ipynb_checkpoints/

# Airflow runtime artifacts (bind-mounted logs if used)
data_pipeline/**/logs/
airflow_logs/
*.pid

# Local docker volume bind-mounts, if used instead of named volumes
pgdata/
airflow_pgdata/

# Phase 4 (deferred) — large/binary artifacts only, transcripts/scripts stay tracked
model_finetuning/raw_audio/*
!model_finetuning/raw_audio/.gitkeep
model_finetuning/model_weights/*
!model_finetuning/model_weights/.gitkeep

# Phase 2 — source FAA orders are large public-domain PDFs, regenerable by re-downloading
# (see mcp_server/source_docs/README.md); the FAISS index + chunk metadata are build
# artifacts regenerated by mcp_server/vector_db/ingest.py, not hand-authored.
mcp_server/source_docs/*.pdf
mcp_server/vector_db/*.index
mcp_server/vector_db/*.jsonl
mcp_server/vector_db/*.pkl

# OS / IDE
.DS_Store
Thumbs.db
.vscode/
.idea/
